#!/usr/bin/env bash
# Fake claude CLI (tests only). Behaviour comes from $FAKE_CTL/<GANGLION_ID>.mode:
#   idle      do nothing, stay alive (default)
#   trust     always show the trust prompt first and wait for Enter
#   deliver   write DELIVERY.md, then call the Stop hook twice like Claude Code does
#   stop      no DELIVERY.md, call the Stop hook once (agent paused mid-way)
#   result    write a structured Spine result to $GANGLION_RESULT_FILE (Spine 2.x contract)
#   failed    write a structured result with status "failed"
#   exit      exit immediately without any result (launcher died)
#   ondemand  stay alive; write DELIVERY.md when $FAKE_CTL/<id>.<attempt>.go appears
# Like the real claude: if $FAKE_CLAUDE_JSON does not trust $PWD, show the trust prompt.
set -u
ctl="${FAKE_CTL:?}"
id="${GANGLION_ID:-none}"
att="${GANGLION_ATTEMPT_ID:-none}"
printf '%s\t%s\t%s\n' "$(date +%s)" "$PWD" "$*" >> "$ctl/$id.invocations"
env | grep '^GANGLION_' | sort > "$ctl/$id.env"
mode=$(cat "$ctl/$id.mode" 2>/dev/null || echo idle)

trusted=no
if [ -n "${FAKE_CLAUDE_JSON:-}" ] && python3 - "$FAKE_CLAUDE_JSON" "$PWD" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
sys.exit(0 if d.get("projects", {}).get(sys.argv[2], {}).get("hasTrustDialogAccepted") is True else 1)
PY
then trusted=yes; fi

if [ "$mode" = trust ] || [ "$trusted" = no ]; then
  echo "Do you trust the files in this folder?"
  echo "$PWD"
  echo " > 1. Yes, proceed"
  echo "   2. No, exit"
  read -r _ans
  : > "$ctl/$id.trust_accepted"
  clear
fi

echo "fake claude running: $*"

run_hook() {
  printf '{"hook_event_name":"Stop","session_id":"fake","cwd":"%s","stop_hook_active":false}' "$PWD" \
    | "${FAKE_STOP_HOOK:?}"
  echo "hook rc=$?" >> "$ctl/$id.hook"
}

deliver() {
  for i in $(seq 1 30); do echo "delivery line $i"; done > DELIVERY.md
  git add DELIVERY.md >/dev/null 2>&1 && git commit -q -m "deliver $id" >/dev/null 2>&1
  run_hook
  run_hook
}

case "$mode" in
  deliver) deliver ;;
  stop) run_hook ;;
  result|failed)
    status=completed; [ "$mode" = failed ] && status=failed
    sha=$(git rev-parse HEAD 2>/dev/null || echo "")
    printf '{"schema":"ganglion.engineering-result/v1","status":"%s","run_id":"run-%s","final_sha":"%s","summary":"structured %s","result_uri":"file:///results/%s"}' \
      "$status" "$id" "$sha" "$id" "$id" > "${GANGLION_RESULT_FILE:?}.tmp"
    mv "${GANGLION_RESULT_FILE}.tmp" "$GANGLION_RESULT_FILE"
    run_hook ;;
  exit) : > "$ctl/$id.ready"; exit 0 ;;
  ondemand)
    : > "$ctl/$id.ready"
    while [ ! -e "$ctl/$id.$att.go" ]; do sleep 0.2; done
    deliver ;;
esac
: > "$ctl/$id.ready"
exec sleep 3600
